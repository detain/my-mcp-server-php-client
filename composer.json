{
    "name": "myadmin/client-mcp-proxy",
    "description": "Standalone MCP proxy server that proxies to MyAdmin API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "dev-main",
        "guzzlehttp/guzzle": "^7.8",
        "symfony/yaml": "^6.4|^7.0",
        "symfony/uid": "^6.4|^7.0",
        "php-http/message": "^1.16",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ClientMcp\\": "src/"
        }
    },
    "bin": ["bin/mcp"],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
